# ==============================================================================
# Environment Configuration for Analyst & Auditor Research Agent
# ==============================================================================

# LLM Providers (Google Gemini is recommended and 100% free via Google AI Studio)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative Providers (Optional)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection (defaults to gemini-2.5-flash or gemini-1.5-flash)
PRIMARY_MODEL=gemini-2.5-flash

# Currency Conversion (1 USD to INR for cost tracking in Rupees)
USD_TO_INR_RATE=86.5

# Search Settings (duckduckgo is built-in and requires no key)
SEARCH_ENGINE=duckduckgo
TAVILY_API_KEY=
